# Copy this file to ".env" and put your real key in it. Never commit .env to git.

# Default setup: Groq (free tier, fast). Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional overrides. Leave them out to use Groq.
# To use OpenAI instead:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=your_openai_key
#   LLM_MODEL=gpt-4o-mini
# To use a local model with Ollama (no key needed, but the field can't be empty):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
